# ---------------------------------------------------------------------------
# Datasets: NEVER committed. Keep directory placeholders (.gitkeep) tracked.
#
# Strategy: ignore the whole subtree with `**`, then re-include the
# placeholder .gitkeep files. We MUST also re-include the intermediate
# directories, otherwise git's "parent directory is ignored" rule blocks the
# re-inclusion.
# ---------------------------------------------------------------------------

# data/raw
/data/raw/**
!/data/raw/
!/data/raw/primary/
!/data/raw/backup/
!/data/raw/.gitkeep
!/data/raw/primary/.gitkeep
!/data/raw/backup/.gitkeep

# data/interim
/data/interim/**
!/data/interim/
!/data/interim/.gitkeep

# data/processed
/data/processed/**
!/data/processed/
!/data/processed/.gitkeep

# data/external
/data/external/**
!/data/external/
!/data/external/.gitkeep

# data/prototype (DEV-02 — prototype dataset storage, scope=IMPORTED_PROTOTYPE)
/data/prototype/**

# Generated reports and figures
/reports/**
!/reports/
!/reports/dataset_audit/
!/reports/preprocessing/
!/reports/feature_engineering/
!/reports/clustering/
!/reports/evaluation/
!/reports/figures/
!/reports/.gitkeep
!/reports/dataset_audit/.gitkeep
!/reports/preprocessing/.gitkeep
!/reports/feature_engineering/.gitkeep
!/reports/clustering/.gitkeep
!/reports/evaluation/.gitkeep
!/reports/figures/.gitkeep

# Generated algorithm comparison artifacts (per AGENTS.md §2.12).
# Source of truth: 9 PNGs are reproducible from
# docs/research/ALGORITHM_THEORY_AND_EXPERIMENTAL_COMPARISON.md +
# the audit numbers in reports/{exp01,exp03,exp05}/*.csv. Therefore the
# PNGs themselves are NOT committed. Only the .gitkeep is tracked so
# the directory structure is preserved across clones.
/reports/algorithm_comparison/**
!/reports/algorithm_comparison/
!/reports/algorithm_comparison/.gitkeep

# Local caches
.cache/
.mypy_cache/
.ruff_cache/
.pyright/
*.tmp
*.bak
# DEV-03 consistency test fixture (per docs/system/DEV-03_preprocessing.md §6.1.4):
# A sample of Online Retail transactions used as input for
# test_dev03_consistency.AC 38a (always run) + AC 38b (C7-dependent opt-in).
# Manually regenerated from ``data/raw/primary/Online Retail.xlsx`` by the
# developer following the plan. NOT committed because the data is derived
# from the raw dataset (per AGENTS.md §2.12 spirit).
# To regenerate, see ``docs/system/DEV-03_preprocessing.md`` §14.
/tests/fixtures/consistency_input.csv
!/tests/fixtures/
!/tests/fixtures/.gitkeep
