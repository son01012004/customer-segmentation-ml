# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER commit it.

# Project
PROJECT_NAME=customer-segmentation-ml

# Paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# Dataset locations (relative to repo root)
PRIMARY_DATASET_PATH=./data/raw/primary
BACKUP_DATASET_PATH=./data/raw/backup

# Runtime
PYTHON_VERSION=3.11
RANDOM_SEED=42

# Logging
LOG_LEVEL=INFO